// Copy this file to Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored and must NOT be committed.
// appid and token come from your app registration at api.lsm.org
LSM_APP_ID = YOUR_LSM_APP_ID_HERE
LSM_TOKEN = YOUR_LSM_TOKEN_HERE

// apikey comes from your app registration at api.esv.org
// Only needed to run scripts/fetch_esv_seed.py (build-time ESV data fetch).
ESV_API_KEY = YOUR_ESV_API_KEY_HERE
