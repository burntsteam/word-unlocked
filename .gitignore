# ─── Secrets — NEVER COMMIT ─────────────────────────────────
WordUnlocked/Config/Secrets.xcconfig
WordUnlocked/Resources/seed_verses_rv_testing.json

# ─── Xcode build artifacts ──────────────────────────────────
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.xcworkspace/xcuserdata/

# ─── Archives & exports ─────────────────────────────────────
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip

# ─── Swift Package Manager ──────────────────────────────────
.swiftpm/

# ─── CocoaPods (not currently used) ─────────────────────────
Pods/
*.xcworkspace

# ─── Fastlane ───────────────────────────────────────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ─── macOS ──────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ─── OMC / Claude Code ──────────────────────────────────────
.omc/
.omx/

# graphify: commit the small durable artifacts (community_labels.json,
# GRAPH_REPORT.md, wiki/, memory/) — the ones that are curated or cost money to
# regenerate. Ignore the large rebuild-on-every-commit outputs and machine-local
# state; `graphify update` reproduces them at zero LLM cost.
.graphify/graph.json
.graphify/studio/
.graphify/manifest.json
.graphify/scope.json
.graphify/cost.json
.graphify/cache/
# graphify writes its AST cache relative to the directory it is invoked from, so a
# run from a subdirectory leaves a stray .graphify/cache/ there. The rules above are
# root-anchored and would not catch it.
**/.graphify/cache/
.graphify/branch.json
.graphify/worktree.json
.graphify/needs_update
.graphify/.graphify_*
.graphify/label-instructions/
.graphify/description-instructions/
__pycache__/
*.pyc
.graphify/obsidian/
.graphify/.obsidian/
.graphify/.DS_Store
.graphify/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
